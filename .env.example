# --- Database (Neon Postgres) ---
# Local dev: created automatically by vite-plugin-neon-new (Neon Launchpad) on `bun run dev`.
# Production (Vercel): set these in Vercel project settings -> Environment Variables.
#
# Runtime should use the POOLED endpoint (serverless-friendly). It looks like:
#   postgresql://user:pass@<host>-pooler.neon.tech/db?sslmode=require
DATABASE_URL=
# Direct (non-pooled) endpoint — used by Drizzle migrations (bun run db:generate / db:migrate).
DATABASE_URL_DIRECT=

# --- Better Auth ---
# http://localhost:3000 in dev; https://<your-app>.vercel.app in production
BETTER_AUTH_URL=
# Generate a new one with: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

BLOB_READ_WRITE_TOKEN=
BLOB_HOST_SUFFIX=
