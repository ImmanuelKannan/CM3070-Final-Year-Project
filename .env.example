# --- Database (Neon Postgres) ---
# Local dev: created automatically by vite-plugin-neon-new (Neon Launchpad) on `npm run dev`.
# Production (Vercel): set these in Vercel project settings -> Environment Variables.
#
# Runtime should use the POOLED endpoint (serverless-friendly). It looks like:
#   postgresql://user:pass@<host>-pooler.neon.tech/db?sslmode=require
DATABASE_URL=
# Direct (non-pooled) endpoint — handy for local tooling if the pooled one misbehaves.
DATABASE_URL_DIRECT=

# --- Better Auth ---
# http://localhost:3000 in dev; https://<your-app>.vercel.app in production
BETTER_AUTH_URL=
# Generate a new one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
